fp8_format: 1          # 0=E4M3, 1=E5M2
saturation: 1            # 1=启用饱和
use_scale: 1           # 1=启用缩放
group_size: 256        # 分组大小
target_range: 57734.0f    # 目标范围
safe_mode: 0           # 0=禁用安全模式
# Hadamard变换
use_as_hadamard: 1           # 1=启用Hadamard变换
lambda: 1e-6f
fp8_max_val: 57734.0f
pivotSwap: 0